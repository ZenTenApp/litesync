# One-shot build image for litesync (static linux/amd64).
# MUST be run with --platform linux/amd64 so the build container itself is
# x86_64 and its gcc can link cgo amd64 code. Alpine's native libc is musl,
# so CGO_ENABLED=1 + gcc produces a fully static binary, matching CI.
FROM golang:1.25-alpine

ENV CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64

# gcc for cgo (go-sqlite3)
RUN apk add --no-cache gcc musl-dev git

WORKDIR /build

# Version is injected via ARG
ARG VERSION=v0.0.0-local
ENV VERSION=${VERSION}

# Copy module files first for layer caching
COPY go.mod go.sum ./

# Build script
COPY <<'EOF' /build/build.sh
#!/bin/sh
set -e
mkdir -p /out
go build \
  -trimpath \
  -ldflags="-s -w -X main.version=${VERSION} -extldflags '-static'" \
  -o /out/litesync-linux-amd64 ./cmd/litesync
cd /out
sha256sum litesync-linux-amd64 > litesync-linux-amd64.sha256
EOF
RUN chmod +x /build/build.sh

# Copy the rest of the source
COPY . .

CMD ["/build/build.sh"]